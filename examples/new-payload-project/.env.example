# Exemplo de variáveis de ambiente para desenvolvimento
# NÃO comitar com segredos reais

# Para Postgres / Supabase
# POSTGRES_URL=postgresql://<user>:<password>@<host>:5432/<db>

# Para MongoDB (fallback)
# MONGODB_URI=mongodb://127.0.0.1:27017/payload

# Variáveis úteis
# PAYLOAD_SECRET=uma-senha-forte
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=strongpassword
